{
  "name": "@friction-telemetry/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh ./scripts/dev.sh",
    "test": "vitest run",
    "check-types": "wrangler types --strict-vars=false --env-file .dev.vars.example --check && tsc --noEmit && tsc --noEmit -p test",
    "cf-typegen": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@friction-telemetry/contracts": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "@typesafe-ai/sdk": "0.6.0",
    "drizzle-orm": "0.45.3",
    "fflate": "0.8.2",
    "hono": "^4.13.9",
    "inngest": "^4.21.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.5",
    "@inngest/test": "^1.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.139.0"
  }
}
